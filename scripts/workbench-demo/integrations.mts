// @effect-diagnostics globalDate:off - Demo setup timestamps are generated by host tooling.
import * as Effect from "effect/Effect";
import * as DateTime from "effect/DateTime";
import { CommandId, ProjectId, ThreadId } from "../../packages/contracts/src/baseSchemas.ts";
import { WorkbenchProjectId } from "../../packages/contracts/src/workbench.ts";
import { WorkbenchJiraBindingId } from "../../packages/contracts/src/workbenchJira.ts";
import { WORKBENCH_WS_METHODS as methods } from "../../packages/contracts/src/workbenchRpc.ts";
import { runRpc, dispatch, readShellSnapshot } from "./local.mts";

export const linkDemoPullRequests = async ({
  wsUrl,
  token,
  urls,
}: {
  wsUrl: string;
  token: string;
  urls: readonly string[];
}) => {
  for (const [index, value] of urls.entries()) {
    const url = new URL(value);
    const match = /^\/([^/]+\/[^/]+)\/pull\/(\d+)$/.exec(url.pathname);
    if (url.protocol !== "https:" || url.hostname !== "github.com" || !match?.[1] || !match[2])
      throw new Error("Expected a GitHub pull request URL.");
    const repository = match[1];
    const number = Number(match[2]);
    await runRpc(wsUrl, token, (client) =>
      dispatch(client, {
        type: "thread.pull-request.link",
        commandId: CommandId.make(`demo-pr-${repository}-${number}`),
        threadId: ThreadId.make(index % 2 === 0 ? "orbit-001-thread" : "orbit-005-thread"),
        host: "github.com",
        repository,
        number,
        url: value,
        source: "manual",
      }),
    );
  }
  return await verifyDemoPullRequests({ wsUrl, token, urls });
};

export const verifyDemoPullRequests = async ({
  wsUrl,
  token,
  urls,
}: {
  wsUrl: string;
  token: string;
  urls: readonly string[];
}) => {
  const shell = await readShellSnapshot(wsUrl, token);
  const linked = new Set(
    shell.threads
      .filter((thread) => ["orbit-001-thread", "orbit-005-thread"].includes(thread.id))
      .flatMap((thread) => thread.pullRequests.map((pr) => pr.url)),
  );
  if (urls.some((url) => !linked.has(url)))
    throw new Error("Not all selected PRs were linked to native demo Threads.");
  return urls.length;
};

export const syncDemoJira = async ({
  wsUrl,
  token,
  site,
  projectKey,
  boardId,
  sprintId,
}: {
  wsUrl: string;
  token: string;
  site: string;
  projectKey: string;
  boardId: number;
  sprintId: number;
}) =>
  runRpc(wsUrl, token, (client) =>
    Effect.gen(function* () {
      const timestamp = DateTime.formatIso(yield* DateTime.now);
      const snapshot = yield* client[methods.workbenchJiraGetSnapshot]({});
      const connection = snapshot.connections.find(
        (item) => new URL(item.siteUrl).origin === new URL(site).origin,
      );
      if (!connection)
        throw new Error(
          "Connect this Jira site in Workbench first; OAuth browser consent is required once.",
        );
      const existing = snapshot.bindings.find((item) => item.id === "demo-jira-binding");
      if (
        existing &&
        (existing.connectionId !== connection.id ||
          existing.boardId !== boardId ||
          existing.sprintId !== sprintId)
      )
        throw new Error(
          "Existing demo Jira binding targets different resources; update it in Workbench explicitly.",
        );
      if (!existing) {
        const projects = yield* client[methods.workbenchJiraListProjects]({
          connectionId: connection.id,
        });
        const project = projects.find((item) => item.key === projectKey);
        if (!project) throw new Error("Configured Jira project is not accessible.");
        const boards = yield* client[methods.workbenchJiraListBoards]({
          connectionId: connection.id,
          projectKeyOrId: projectKey,
        });
        const board = boards.find((item) => item.id === boardId);
        if (!board || (board.type !== "scrum" && board.type !== "simple"))
          throw new Error("Select an accessible sprint board for this Jira project.");
        const sprints = yield* client[methods.workbenchJiraListSprints]({
          connectionId: connection.id,
          boardId,
        });
        const sprint = sprints.find((item) => item.id === sprintId);
        if (!sprint) throw new Error("Configured sprint is not available on this board.");
        const workbench = yield* client[methods.workbenchGetSnapshot]({});
        if (!workbench.projects.some((item) => item.id === "demo-jira")) {
          yield* client[methods.workbenchCreateProject]({
            id: WorkbenchProjectId.make("demo-jira"),
            title: "Orbit Jira",
            linkedProjectIds: [ProjectId.make("orbit-api"), ProjectId.make("orbit-web")],
            createdAt: timestamp,
          });
        }
        yield* client[methods.workbenchJiraCreateBinding]({
          id: WorkbenchJiraBindingId.make("demo-jira-binding"),
          projectId: WorkbenchProjectId.make("demo-jira"),
          connectionId: connection.id,
          jiraProjectId: project.id,
          jiraProjectKey: project.key,
          jiraProjectName: project.name,
          boardId,
          boardName: board.name,
          sprintId,
          sprintName: sprint.name,
          defaultPrimaryT3ProjectId: ProjectId.make("orbit-api"),
          defaultRepositoryProjectIds: [ProjectId.make("orbit-api"), ProjectId.make("orbit-web")],
          statusMappings: [],
          boardMode: "mirror_jira",
          followActiveSprint: false,
          selectedSprints: [{ id: sprint.id, name: sprint.name }],
          createdAt: timestamp,
        });
      }
      return yield* client[methods.workbenchJiraSyncBinding]({
        bindingId: WorkbenchJiraBindingId.make("demo-jira-binding"),
      });
    }),
  );

export const verifyDemoJira = async ({
  wsUrl,
  token,
  site,
  boardId,
  projectKey,
  sprintId,
  expectedKeys,
}: {
  wsUrl: string;
  token: string;
  site: string;
  boardId: number;
  projectKey: string;
  sprintId: number;
  expectedKeys: readonly string[];
}) => {
  const snapshot = await runRpc(wsUrl, token, (client) =>
    client[methods.workbenchJiraGetSnapshot]({}),
  );
  const connection = snapshot.connections.find(
    (item) => new URL(item.siteUrl).origin === new URL(site).origin,
  );
  const binding = snapshot.bindings.find(
    (item) =>
      item.connectionId === connection?.id &&
      item.boardId === boardId &&
      item.jiraProjectKey === projectKey &&
      item.sprintId === sprintId &&
      item.active,
  );
  if (!binding?.lastSyncedAt || binding.lastSyncError)
    throw new Error(
      binding?.lastSyncError ||
        "No successful active Jira sync exists for the configured site/board. Run sync-jira after OAuth consent.",
    );
  const links = snapshot.issueLinks.filter((item) => item.bindingId === binding.id && item.active);
  if (!links.length)
    throw new Error(
      "Jira sync imported no assigned sprint issues. Assign demo issues to the connected user and selected sprint.",
    );
  const missing = expectedKeys.filter((key) => !links.some((link) => link.issue.key === key));
  if (missing.length)
    throw new Error(`Expected demo Jira issues were not imported: ${missing.join(", ")}`);
  if (!links.some((link) => link.issue.epic !== null))
    throw new Error("No imported Jira demo issue has an Epic parent.");
  return {
    bindingId: binding.id,
    lastSyncedAt: binding.lastSyncedAt,
    importedIssues: links.length,
    verification: "Import completeness only; Jira workflow states are reported by jira --apply.",
  };
};
