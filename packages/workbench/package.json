{
  "name": "@t3tools/workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./WorkspaceLifecycleService": {
      "types": "./src/WorkspaceLifecycleService.ts",
      "import": "./src/WorkspaceLifecycleService.ts"
    },
    "./TicketSummaryService": {
      "types": "./src/TicketSummaryService.ts",
      "import": "./src/TicketSummaryService.ts"
    },
    "./TicketSummaryHost": {
      "types": "./src/TicketSummaryHost.ts",
      "import": "./src/TicketSummaryHost.ts"
    },
    "./ThreadRecapService": {
      "types": "./src/ThreadRecapService.ts",
      "import": "./src/ThreadRecapService.ts"
    },
    "./ThreadRecapHost": {
      "types": "./src/ThreadRecapHost.ts",
      "import": "./src/ThreadRecapHost.ts"
    },
    "./WorkbenchStore": {
      "types": "./src/WorkbenchStore.ts",
      "import": "./src/WorkbenchStore.ts"
    },
    "./WorkbenchNativeAccess": {
      "types": "./src/WorkbenchNativeAccess.ts",
      "import": "./src/WorkbenchNativeAccess.ts"
    },
    "./TicketWorkspaceService": {
      "types": "./src/TicketWorkspaceService.ts",
      "import": "./src/TicketWorkspaceService.ts"
    },
    "./TicketWorkspaceHost": {
      "types": "./src/TicketWorkspaceHost.ts",
      "import": "./src/TicketWorkspaceHost.ts"
    },
    "./TicketDraftService": {
      "types": "./src/TicketDraftService.ts",
      "import": "./src/TicketDraftService.ts"
    },
    "./TicketDraftHost": {
      "types": "./src/TicketDraftHost.ts",
      "import": "./src/TicketDraftHost.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && node check-boundary.mjs",
    "test": "vp test run",
    "check:boundary": "node check-boundary.mjs",
    "lint": "vp run -w workbench:lint",
    "knip": "vp run -w workbench:knip",
    "fallow": "vp run -w workbench:fallow",
    "fallow:audit": "vp run -w workbench:fallow:audit",
    "fallow:health": "vp run -w workbench:fallow:health",
    "fallow:dupes": "vp run -w workbench:fallow:dupes",
    "quality": "vp run lint && vp run knip && vp run fallow && vp run -w workbench:restyle-ceiling"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  }
}
