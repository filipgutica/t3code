---
type Lane = "main" | "fork" | "parallel" | "merge";

interface Props {
  lane: Lane;
  terminal?: boolean;
}

const { lane, terminal = false } = Astro.props;
const paths: Record<Lane, string> = {
  main: "M72 48 H0",
  fork: "M72 0 V12 C72 34 32 22 32 48 H0",
  parallel: "M32 48 H0",
  merge: "M32 48 H0 M32 48 C32 74 72 62 72 96",
};
---

<div class={`commit-branch commit-branch--${lane}`} aria-hidden="true">
  <svg class="commit-junction" viewBox="0 0 96 96" focusable="false">
    <path d={paths[lane]} />
    <circle class="commit-node" cx={lane === "main" ? 72 : 32} cy="48" r="5" />
    {lane === "parallel" && <circle class="commit-neutral-node" cx="72" cy="48" r="3" />}
  </svg>
  {terminal && <svg class="commit-terminal" viewBox="0 0 96 16" focusable="false"><circle cx="72" cy="8" r="4" /></svg>}
</div>
