<dialog id="image-lightbox" aria-labelledby="image-lightbox-title">
  <div class="lightbox-toolbar">
    <p id="image-lightbox-title">Product screenshot</p>
    <form method="dialog">
      <button aria-label="Close screenshot" autofocus>Close <span aria-hidden="true">×</span></button>
    </form>
  </div>
  <img alt="" />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#image-lightbox");
  const image = dialog?.querySelector("img");
  const title = dialog?.querySelector("#image-lightbox-title");

  if (dialog && image && title) {
    let opener: HTMLAnchorElement | null = null;

    document.querySelectorAll<HTMLAnchorElement>("[data-product-image]").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = link;
        image.src = link.href;
        image.alt = link.querySelector("img")?.alt ?? "Product screenshot";
        title.textContent = image.alt;
        dialog.showModal();
      });
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      opener?.focus({ preventScroll: true });
      image.removeAttribute("src");
    });
  }
</script>

<style>
  dialog {
    width: fit-content;
    max-width: calc(100vw - 40px);
    max-height: calc(100svh - 40px);
    padding: 16px;
    color: var(--fg);
    background: #141519;
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 24px 100px #0009;
  }
  dialog::backdrop { background: #050709e6; }
  .lightbox-toolbar { display: flex; align-items: center; gap: 24px; margin-bottom: 14px; }
  p { flex: 1; margin: 0; font-size: 13px; color: var(--muted); }
  button { padding: 9px 14px; border: 1px solid var(--border); border-radius: 8px; background: #24282c; color: var(--fg); font: inherit; cursor: pointer; white-space: nowrap; }
  button:hover { background: #343a3f; }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  img { display: block; width: auto; height: auto; max-width: 100%; max-height: calc(100svh - 140px); margin: auto; object-fit: contain; border-radius: 8px; }
  :global(html:has(#image-lightbox[open])) { overflow: hidden; }
  @media (prefers-reduced-motion: no-preference) {
    dialog[open] { animation: lightbox-enter 180ms ease-out; }
    @keyframes lightbox-enter { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  }
  @media (max-width: 600px) {
    dialog { max-width: calc(100vw - 16px); padding: 10px; }
    .lightbox-toolbar { gap: 12px; }
  }
</style>
