<dialog id="image-lightbox" aria-labelledby="image-lightbox-title">
  <div class="lightbox-toolbar">
    <p id="image-lightbox-title">Product screenshot</p>
    <form method="dialog">
      <button aria-label="Close screenshot" autofocus>Close <span aria-hidden="true">×</span></button>
    </form>
  </div>
  <img alt="" />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#image-lightbox");
  const image = dialog?.querySelector("img");
  const title = dialog?.querySelector("#image-lightbox-title");

  if (dialog && image && title) {
    let opener: HTMLAnchorElement | null = null;

    document.querySelectorAll<HTMLAnchorElement>("[data-product-image]").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = link;
        image.src = link.href;
        image.alt = link.querySelector("img")?.alt ?? "Product screenshot";
        title.textContent = image.alt;
        dialog.showModal();
      });
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      opener?.focus({ preventScroll: true });
      image.removeAttribute("src");
    });
  }
</script>

<style>
  dialog {
    width: fit-content;
    max-width: calc(100vw - var(--space-8));
    max-height: calc(100svh - var(--space-8));
    padding: var(--space-4);
    color: var(--text);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-popover);
  }
  dialog::backdrop { background: color-mix(in srgb, var(--text) 70%, transparent); }
  .lightbox-toolbar { display: flex; align-items: center; gap: var(--space-6); margin-bottom: var(--space-3); }
  p { flex: 1; margin: 0; font-size: var(--text-sm); color: var(--text-muted); }
  button { min-height: var(--control-lg); padding-inline: var(--space-3); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); color: var(--text); font: inherit; cursor: pointer; white-space: nowrap; }
  button:hover { background: var(--surface-hover); }
  img { display: block; width: auto; height: auto; max-width: 100%; max-height: calc(100svh - var(--space-16) - var(--space-16)); margin: auto; object-fit: contain; border-radius: var(--radius-md); }
  :global(html:has(#image-lightbox[open])) { overflow: hidden; }
  @media (prefers-reduced-motion: no-preference) {
    dialog[open] { animation: lightbox-enter var(--duration) var(--ease-out); }
    @keyframes lightbox-enter { from { opacity: 0; transform: translateY(var(--space-3)); } to { opacity: 1; transform: none; } }
  }
  @media (max-width: 600px) {
    dialog { max-width: calc(100vw - var(--space-4)); padding: var(--space-2); }
    .lightbox-toolbar { gap: var(--space-3); }
  }
</style>
