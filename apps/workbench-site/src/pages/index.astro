---
import { getImage } from "astro:assets";
import App from "../App.vue";
import type { ProductImageDescriptor, ImageCrop } from "../images";
import type { ImageMetadata } from "astro";
import libraryThemeCss from "@filipgutica/ui/theme.css?raw";
import sitePaletteCss from "@filipgutica/ui/themes/graphite-indigo.css?raw";
import { siteThemeBootScript } from "@filipgutica/ui/site";
import board from "../assets/screenshots/board.png";
import ticket from "../assets/screenshots/ticket.png";
import workspace from "../assets/screenshots/workspace.png";
import thread from "../assets/screenshots/thread.png";
import pullRequest from "../assets/screenshots/pull-request.png";
import notifications from "../assets/screenshots/notifications.png";
import jira from "../assets/screenshots/jira.png";
import "../styles/site.css";

const repository = "https://github.com/filipgutica/t3code";
const guide = `${repository}/blob/main/docs/user/agent-workbench.md`;
const downloads = `${repository}/releases/latest`;
const title = "T3 Code Workbench | Your work, across repositories";
const description =
  "Tickets, isolated worktrees, native T3 Threads, and pull requests across repositories. An independent T3 Code fork with optional Jira integration.";
const base = import.meta.env.BASE_URL;
const canonical = new URL(base, Astro.site);
const shareImage = await getImage({ src: board, width: 1200, format: "jpeg", quality: 85 });
const screenshotSizes =
  "(max-width: 640px) calc(100vw - 32px), (max-width: 1168px) calc(100vw - 48px), 1120px";
const workspaceCrop = { x: 48, y: 683, width: 1932, height: 720 };
const workspaceImageScale = workspace.width / workspaceCrop.width;
const workspaceCropSizes = `(max-width: 640px) calc(${100 * workspaceImageScale}vw - ${32 * workspaceImageScale}px), (max-width: 1014px) calc(${100 * workspaceImageScale}vw - ${48 * workspaceImageScale}px), ${workspace.width / 2}px`;
const walkthrough = [
  {
    id: "ticket",
    tab: "Ticket",
    title: "Start with the Ticket",
    src: ticket,
    alt: "Workbench Ticket showing its description and linked native T3 Threads",
    caption:
      "A goal, acceptance criteria, and linked native Threads.",
  },
  {
    id: "workspace",
    tab: "Workspace",
    title: "Prepare the workspace",
    src: workspace,
    alt: "Prepared Ticket workspace showing repository worktrees",
    caption:
      "Isolated worktrees per repository. Preparation does not start an agent.",
  },
  {
    id: "thread",
    tab: "Thread",
    title: "Open a native T3 Thread",
    src: thread,
    alt: "Native T3 Thread with Ticket context attached to the composer",
    caption:
      "Ticket context is attached. Send a message to start the agent.",
  },
  {
    id: "pull-request",
    tab: "Pull request",
    title: "Review the linked pull request",
    src: pullRequest,
    alt: "Native pull request panel over a demo Ticket showing its summary and failing checks",
    caption: "Linked PR checks and review feedback on a second demo Ticket.",
  },
  {
    id: "notifications",
    tab: "Notifications",
    title: "See what needs attention",
    src: notifications,
    alt: "Ticket Needs attention list with five signals from Threads and linked pull requests",
    caption:
      "Threads, review feedback, and failed checks that need attention.",
  },
  {
    id: "jira",
    tab: "Jira (optional)",
    title: "Bring Jira into the same workflow",
    src: jira,
    alt: "Workbench Jira board showing the selected sprint, sync timestamp, and issue statuses",
    caption: "Assigned sprint issues in Workbench.",
  },
];
const prepareImage = async ({
  src,
  alt,
  eager = false,
  sizes,
  crop,
}: {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  sizes: string;
  crop?: ImageCrop;
}): Promise<ProductImageDescriptor> => {
  const image = await getImage({
    src,
    alt,
    widths: [480, 800, 1200, 1600, 2400].filter((width) => width < src.width).concat(src.width),
    format: "webp",
  });
  return {
    src: image.src,
    srcset: image.srcSet.attribute,
    original: src.src,
    width: src.width,
    height: src.height,
    alt,
    sizes,
    eager,
    crop,
  };
};
const steps = await Promise.all(
  walkthrough.map(async ({ src, alt, ...step }) => ({
    ...step,
    image: await prepareImage({ src, alt, sizes: screenshotSizes }),
  })),
);
const images = {
  board: await prepareImage({
    src: board,
    alt: "Orbit Workbench Board with Tickets spanning Orbit Web and Orbit API across workflow statuses",
    sizes: screenshotSizes,
    eager: true,
  }),
  workspace: await prepareImage({
    src: workspace,
    crop: workspaceCrop,
    sizes: workspaceCropSizes,
    alt: "Prepared Ticket workspace with worktrees for Orbit Web and Orbit API",
  }),
  pullRequest: await prepareImage({
    src: pullRequest,
    sizes: screenshotSizes,
    alt: "Native pull request panel over a demo Ticket showing its summary and failing checks",
  }),
};
const darkTokens = [libraryThemeCss, sitePaletteCss].map((css) => {
  const tokens = css.match(/:root\.dark\s*\{([^}]+)\}/)?.[1];
  if (!tokens) throw new Error("The dark theme tokens are missing.");
  return tokens;
}).join("\n");
const lightCanvas = sitePaletteCss.match(/--color-bg:\s*([^;]+);/)?.[1];
const darkCanvas = darkTokens.match(/--color-bg:\s*([^;]+);/g)?.at(-1)?.match(/:\s*([^;]+);/)?.[1];
if (!lightCanvas || !darkCanvas) throw new Error("The canvas colors are missing.");
const noScriptDarkCss = `@media (prefers-color-scheme: dark) { :root:not(.dark) { ${darkTokens} } }`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={lightCanvas} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={darkCanvas} media="(prefers-color-scheme: dark)" />
    <script is:inline set:html={siteThemeBootScript}></script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(shareImage.src, Astro.site)} />
    <meta property="og:image:alt" content="T3 Code Workbench Board showing Tickets across workflow statuses." />
    <meta name="twitter:card" content="summary_large_image" />
    <noscript><style is:global set:html={noScriptDarkCss}></style></noscript>
  </head>
  <body>
    <App client:load images={images} walkthrough={steps} base={base} repository={repository} guide={guide} downloads={downloads} />
  </body>
</html>
