---
import { getImage } from "astro:assets";
import App from "../App.vue";
import type { ProductImageDescriptor, ProductImageSource } from "../images";
import type { ImageMetadata } from "astro";
import libraryThemeCss from "@filipgutica/ui/theme.css?raw";
import sitePaletteCss from "../styles/t3-theme.css?raw";
import { siteThemeBootScript } from "@filipgutica/ui/site";
import board from "../assets/screenshots/board.png";
import boardLight from "../assets/screenshots/board-light.png";
import ticket from "../assets/screenshots/ticket.png";
import ticketLight from "../assets/screenshots/ticket-light.png";
import workspace from "../assets/screenshots/workspace.png";
import workspaceLight from "../assets/screenshots/workspace-light.png";
import thread from "../assets/screenshots/thread.png";
import threadLight from "../assets/screenshots/thread-light.png";
import pullRequest from "../assets/screenshots/pull-request.png";
import pullRequestLight from "../assets/screenshots/pull-request-light.png";
import notifications from "../assets/screenshots/notifications.png";
import notificationsLight from "../assets/screenshots/notifications-light.png";
import planning from "../assets/screenshots/planning.png";
import planningLight from "../assets/screenshots/planning-light.png";
import ticketChat from "../assets/screenshots/ticket-chat.png";
import ticketChatLight from "../assets/screenshots/ticket-chat-light.png";
import boardChat from "../assets/screenshots/board-chat.png";
import boardChatLight from "../assets/screenshots/board-chat-light.png";
import "../styles/site.css";

const repository = "https://github.com/filipgutica/t3code";
const guide = `${repository}/blob/main/docs/user/agent-workbench.md`;
const downloads = `${repository}/releases/latest`;
const title = "T3 Code Workbench | Your work, across repositories";
const description =
  "Tickets, isolated worktrees, native T3 Threads, and pull requests across repositories. An independent T3 Code fork.";
const base = import.meta.env.BASE_URL;
const canonical = new URL(base, Astro.site);
const shareImage = await getImage({ src: board, width: 1200, format: "jpeg", quality: 85 });
// Matches the content column: the frame minus its graph column, then the split and pair layouts.
const sizes = {
  full: "(max-width: 640px) calc(100vw - 60px), (max-width: 900px) calc(100vw - 84px), 1096px",
  split: "(max-width: 900px) calc(100vw - 60px), 720px",
  pair: "(max-width: 900px) calc(100vw - 60px), 536px",
};
const prepareSource = async (src: ImageMetadata): Promise<ProductImageSource> => {
  const image = await getImage({
    src,
    widths: [480, 800, 1200, 1600, 2400].filter((width) => width < src.width).concat(src.width),
    format: "webp",
  });
  return {
    src: image.src,
    srcset: image.srcSet.attribute,
    original: src.src,
    width: src.width,
    height: src.height,
  };
};
const prepareImage = async ({
  src,
  light,
  alt,
  eager = false,
  sizes,
}: {
  src: ImageMetadata;
  light: ImageMetadata;
  alt: string;
  eager?: boolean;
  sizes: string;
}): Promise<ProductImageDescriptor> => {
  if (src.width !== light.width || src.height !== light.height)
    throw new Error(`Screenshot themes must have matching dimensions: ${alt}`);
  const [darkSource, lightSource] = await Promise.all([prepareSource(src), prepareSource(light)]);
  return { ...darkSource, light: lightSource, alt, sizes, eager };
};
const images = {
  board: await prepareImage({
    src: board,
    light: boardLight,
    alt: "Beacon Workbench Board with Tickets across Beacon CLI and Beacon Docs and the board chat",
    sizes: sizes.full,
    eager: true,
  }),
  planning: await prepareImage({
    src: planning,
    light: planningLight,
    alt: "Native planning conversation proposing a Beacon Ticket beside its editable draft",
    sizes: sizes.split,
  }),
  boardChat: await prepareImage({
    src: boardChat,
    light: boardChatLight,
    alt: "Board chat with its Thread menu open, showing recaps, a Thread waiting for approval, and New ticket draft",
    sizes: sizes.split,
  }),
  ticket: await prepareImage({
    src: ticket,
    light: ticketLight,
    alt: "Workbench Ticket showing its description and linked native T3 Threads",
    sizes: sizes.split,
  }),
  workspace: await prepareImage({
    src: workspace,
    light: workspaceLight,
    alt: "Prepared Ticket work area with primary and secondary repository worktrees",
    sizes: sizes.full,
  }),
  thread: await prepareImage({
    src: thread,
    light: threadLight,
    alt: "Native T3 Thread continuing the planning conversation in the Ticket work area",
    sizes: sizes.pair,
  }),
  ticketChat: await prepareImage({
    src: ticketChat,
    light: ticketChatLight,
    alt: "Ticket chat on a Ticket page, its Thread menu showing one Thread waiting for approval and another with its recap",
    sizes: sizes.pair,
  }),
  pullRequest: await prepareImage({
    src: pullRequest,
    light: pullRequestLight,
    alt: "Native pull request panel over a demo Ticket showing its summary and failing checks",
    sizes: sizes.full,
  }),
  notifications: await prepareImage({
    src: notifications,
    light: notificationsLight,
    alt: "Ticket Needs attention list with failed checks, requested changes, and unresolved threads on linked pull requests",
    sizes: sizes.split,
  }),
};
const darkTokens = [libraryThemeCss, sitePaletteCss].map((css) => {
  const tokens = css.match(/:root\.dark\s*\{([^}]+)\}/)?.[1];
  if (!tokens) throw new Error("The dark theme tokens are missing.");
  return tokens;
}).join("\n");
const lightCanvas = sitePaletteCss.match(/--color-bg:\s*([^;]+);/)?.[1];
const darkCanvas = darkTokens.match(/--color-bg:\s*([^;]+);/g)?.at(-1)?.match(/:\s*([^;]+);/)?.[1];
if (!lightCanvas || !darkCanvas) throw new Error("The canvas colors are missing.");
const noScriptDarkCss = `@media (prefers-color-scheme: dark) { :root:not(.dark) { ${darkTokens} } }`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={lightCanvas} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={darkCanvas} media="(prefers-color-scheme: dark)" />
    <script is:inline set:html={siteThemeBootScript}></script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(shareImage.src, Astro.site)} />
    <meta property="og:image:alt" content="T3 Code Workbench Board showing Tickets across workflow statuses." />
    <meta name="twitter:card" content="summary_large_image" />
    <noscript><style is:global set:html={noScriptDarkCss}></style></noscript>
  </head>
  <body>
    <App client:load images={images} base={base} repository={repository} guide={guide} downloads={downloads} />
  </body>
</html>
