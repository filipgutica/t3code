---
import { getImage } from "astro:assets";
import App from "../App.vue";
import type { ProductImageDescriptor, ProductImageSource } from "../images";
import type { ImageMetadata } from "astro";
import libraryThemeCss from "@filipgutica/ui/theme.css?raw";
import graphiteThemeCss from "@filipgutica/ui/themes/graphite-indigo.css?raw";
import sitePaletteCss from "../styles/t3-theme.css?raw";
import { siteThemeBootScript } from "@filipgutica/ui/site";
import board from "../assets/screenshots/board.png";
import boardLight from "../assets/screenshots/board-light.png";
import ticket from "../assets/screenshots/ticket.png";
import ticketLight from "../assets/screenshots/ticket-light.png";
import workspace from "../assets/screenshots/thread-context.png";
import workspaceLight from "../assets/screenshots/thread-context-light.png";
import thread from "../assets/screenshots/reference.png";
import threadLight from "../assets/screenshots/reference-light.png";
import pullRequest from "../assets/screenshots/pull-requests.png";
import pullRequestLight from "../assets/screenshots/pull-requests-light.png";
import notifications from "../assets/screenshots/terminal.png";
import notificationsLight from "../assets/screenshots/terminal-light.png";
import planning from "../assets/screenshots/planning.png";
import planningLight from "../assets/screenshots/planning-light.png";
import ticketChat from "../assets/screenshots/recaps.png";
import ticketChatLight from "../assets/screenshots/recaps-light.png";
import boardChat from "../assets/screenshots/agent-edit.png";
import boardChatLight from "../assets/screenshots/agent-edit-light.png";
import "../styles/site.css";

const repository = "https://github.com/filipgutica/t3code";
const guide = `${repository}/blob/main/docs/user/agent-workbench.md`;
const downloads = `${repository}/releases/latest`;
const title = "T3 Code Workbench | One Ticket for work across repositories";
const description =
  "Plan connected work in a conversation, split it into a native T3 Thread for each PR across repositories, and follow PRs, attention, and recaps from one Ticket. An independent T3 Code fork.";
const base = import.meta.env.BASE_URL;
const canonical = new URL(base, Astro.site);
const shareImage = await getImage({ src: ticket, width: 1200, format: "jpeg", quality: 85 });
// Matches the content column: the frame minus its graph column, then the split and pair layouts.
const sizes = {
  full: "(max-width: 640px) calc(100vw - 60px), (max-width: 900px) calc(100vw - 84px), 1096px",
  split: "(max-width: 900px) calc(100vw - 60px), 720px",
  pair: "(max-width: 900px) calc(100vw - 60px), 536px",
};
const prepareSource = async (src: ImageMetadata): Promise<ProductImageSource> => {
  const image = await getImage({
    src,
    widths: [480, 800, 1200, 1600, 2400].filter((width) => width < src.width).concat(src.width),
    format: "webp",
  });
  return {
    src: image.src,
    srcset: image.srcSet.attribute,
    original: src.src,
    width: src.width,
    height: src.height,
  };
};
const prepareImage = async ({
  src,
  light,
  alt,
  eager = false,
  sizes,
}: {
  src: ImageMetadata;
  light: ImageMetadata;
  alt: string;
  eager?: boolean;
  sizes: string;
}): Promise<ProductImageDescriptor> => {
  if (src.width !== light.width || src.height !== light.height)
    throw new Error(`Screenshot themes must have matching dimensions: ${alt}`);
  const [darkSource, lightSource] = await Promise.all([prepareSource(src), prepareSource(light)]);
  return { ...darkSource, light: lightSource, alt, sizes, eager };
};
const images = {
  ticket: await prepareImage({
    src: ticket,
    light: ticketLight,
    alt: "Demo Orbit Ticket with three planned PRs across Orbit API and Orbit Web, Progress, attention, and Threads",
    sizes: sizes.full,
    eager: true,
  }),
  planning: await prepareImage({
    src: planning,
    light: planningLight,
    alt: "Planning Thread in the Orbit Board chat with the draft's brief, Progress, and References",
    sizes: sizes.split,
  }),
  board: await prepareImage({
    src: board,
    light: boardLight,
    alt: "Orbit Board with the invitation Ticket In Progress and one of three planned PRs complete",
    sizes: sizes.split,
  }),
  agentEdit: await prepareImage({
    src: boardChat,
    light: boardChatLight,
    alt: "Agent edit to the Ticket brief with the change, Undo, and Accept available for review",
    sizes: sizes.split,
  }),
  reference: await prepareImage({
    src: thread,
    light: threadLight,
    alt: "Expired-invitation HTML mockup open beside its Thread's conversation on the Ticket",
    sizes: sizes.split,
  }),
  threadContext: await prepareImage({
    src: workspace,
    light: workspaceLight,
    alt: "Shared context listing the Ticket's Threads with recaps and two prepared repository worktrees",
    sizes: sizes.pair,
  }),
  terminal: await prepareImage({
    src: notifications,
    light: notificationsLight,
    alt: "Pending invitations Thread's terminal showing git status in its separate Orbit Web checkout",
    sizes: sizes.pair,
  }),
  pullRequests: await prepareImage({
    src: pullRequest,
    light: pullRequestLight,
    alt: "Ticket with merged Orbit API PR 41 and open Orbit Web PR 88, attention, and PR 88's summary panel",
    sizes: sizes.full,
  }),
  recaps: await prepareImage({
    src: ticketChat,
    light: ticketChatLight,
    alt: "Ticket Threads menu with status and one-line recap previews, the unread Thread first",
    sizes: sizes.split,
  }),
};
const darkTokens = [libraryThemeCss, graphiteThemeCss, sitePaletteCss].map((css) => {
  const tokens = css.match(/:root\.dark\s*\{([^}]+)\}/)?.[1];
  if (!tokens) throw new Error("The dark theme tokens are missing.");
  return tokens;
}).join("\n");
const lightCanvas = graphiteThemeCss.match(/--color-bg:\s*([^;]+);/)?.[1];
const darkCanvas = darkTokens.match(/--color-bg:\s*([^;]+);/g)?.at(-1)?.match(/:\s*([^;]+);/)?.[1];
if (!lightCanvas || !darkCanvas) throw new Error("The canvas colors are missing.");
const noScriptDarkCss = `@media (prefers-color-scheme: dark) { :root:not(.dark) { ${darkTokens} } }`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={lightCanvas} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={darkCanvas} media="(prefers-color-scheme: dark)" />
    <script is:inline set:html={siteThemeBootScript}></script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(shareImage.src, Astro.site)} />
    <meta property="og:image:alt" content="Demo Orbit Ticket with three planned PRs across Orbit API and Orbit Web" />
    <meta name="twitter:card" content="summary_large_image" />
    <noscript><style is:global set:html={noScriptDarkCss}></style></noscript>
  </head>
  <body>
    <App client:load images={images} base={base} repository={repository} guide={guide} downloads={downloads} />
  </body>
</html>
